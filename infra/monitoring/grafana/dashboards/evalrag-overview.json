{
  "uid": "evalrag-overview",
  "title": "EvalRAG overview",
  "tags": [
    "evalrag"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "editable": false,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests / s by route",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "evalrag-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "evalrag-prometheus"
          },
          "expr": "sum by (route, status) (rate(evalrag_http_requests_total[5m]))",
          "legendFormat": "{{route}} {{status}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Request latency p95 by route",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "evalrag-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "evalrag-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(evalrag_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Strategy latency p50 / p95",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "evalrag-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "evalrag-prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le, strategy) (rate(evalrag_strategy_duration_seconds_bucket[15m])))",
          "legendFormat": "p50 {{strategy}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "evalrag-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, strategy) (rate(evalrag_strategy_duration_seconds_bucket[15m])))",
          "legendFormat": "p95 {{strategy}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Tokens / min by model and strategy",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "evalrag-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "evalrag-prometheus"
          },
          "expr": "sum by (model, strategy, direction) (rate(evalrag_llm_tokens_total[5m])) * 60",
          "legendFormat": "{{model}} {{strategy}} {{direction}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Refusals / hour by strategy and reason",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "evalrag-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "evalrag-prometheus"
          },
          "expr": "sum by (strategy, reason) (increase(evalrag_refusals_total[1h]))",
          "legendFormat": "{{strategy}} {{reason}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Circuit breakers (0 closed, 1 half-open, 2 open)",
      "description": "Anthropic and Qdrant breakers. 2 means calls are being rejected.",
      "datasource": {
        "type": "prometheus",
        "uid": "evalrag-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "evalrag-prometheus"
          },
          "expr": "evalrag_circuit_breaker_state",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Telemetry export: delivered vs dropped",
      "description": "Drops never affect requests; they mean Langfuse is down or the queue is full.",
      "datasource": {
        "type": "prometheus",
        "uid": "evalrag-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "evalrag-prometheus"
          },
          "expr": "sum by (exporter) (rate(evalrag_telemetry_exported_total[5m]))",
          "legendFormat": "exported {{exporter}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "evalrag-prometheus"
          },
          "expr": "sum by (exporter, reason) (rate(evalrag_telemetry_dropped_total[5m]))",
          "legendFormat": "dropped {{exporter}} {{reason}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Backend process memory",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "evalrag-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "evalrag-prometheus"
          },
          "expr": "process_resident_memory_bytes{job=\"evalrag-backend\"}",
          "legendFormat": "RSS"
        }
      ]
    }
  ]
}
