# ============================================================================
# EvalRAG Configuration
# ============================================================================
#
# Copy this file to .env and fill in your values.
# Required keys: ANTHROPIC_API_KEY (for production use)
# Optional keys: Can be left blank for smoke tests; features gracefully no-op
#
# Get API keys:
#   - Anthropic:    https://console.anthropic.com/account/keys
#   - OpenAI:       https://platform.openai.com/account/api-keys
#   - Cohere:       https://dashboard.cohere.com/api-keys (future use)
#   - W&B:          https://wandb.ai/settings/keys
#
# ============================================================================

# ============================================================================
# LLM Provider API Keys
# ============================================================================

# Anthropic API Key [REQUIRED for production]
# Used by default for generation, evaluation (judge), and graph extraction.
# Get at: https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=

# OpenAI API Key [OPTIONAL]
# Only needed if GENERATOR_PROVIDER=openai
# Get at: https://platform.openai.com/account/api-keys
OPENAI_API_KEY=

# Cohere API Key [OPTIONAL]
# Reserved for future embedding/reranking support. Leave blank.
COHERE_API_KEY=

# ============================================================================
# Generator Configuration
# ============================================================================

# Generator provider: anthropic | openai | local
# Default: anthropic
# - anthropic: Use Claude models (ANTHROPIC_API_KEY required)
# - openai: Use GPT models (OPENAI_API_KEY required)
# - local: Use Ollama on localhost (no API key needed)
GENERATOR_PROVIDER=anthropic

# Claude model for answer generation [Default: claude-sonnet-4-6]
# Valid models:
#   - claude-opus-4-7            (highest quality, slower, higher cost)
#   - claude-opus-4-1-20250805   (previous flagship)
#   - claude-sonnet-4-6          (balanced quality and speed) [RECOMMENDED]
#   - claude-sonnet-4-20250514   (previous version)
#   - claude-haiku-4-5-20251001  (fastest, cheapest)
GENERATOR_MODEL=claude-sonnet-4-6

# OpenAI model for generation (if GENERATOR_PROVIDER=openai)
# Default: gpt-4o-mini
# Other options: gpt-4o, gpt-4-turbo, gpt-4
OPENAI_GENERATOR_MODEL=gpt-4o-mini

# ============================================================================
# Ollama (Local LLM)
# ============================================================================
# Only used if GENERATOR_PROVIDER=local

# Ollama host URL
# - Docker: Leave blank (infra/docker-compose.yml sets host.docker.internal:11434)
# - Direct uvicorn: Set to http://localhost:11434
OLLAMA_HOST=

# Ollama model to use [Default: llama3.1:8b]
# Pull models with: ollama pull <model-name>
# Popular options: llama3.1:8b, llama2:13b, mistral:latest
OLLAMA_MODEL=llama3.1:8b

# ============================================================================
# Evaluation Models
# ============================================================================

# Claude model for LLM-as-judge evaluation [Default: claude-opus-4-7]
# Used for grading answer quality, faithfulness, relevance.
# Recommendation: Use an efficient model for cost (e.g., claude-haiku-4-5-20251001)
JUDGE_MODEL=claude-opus-4-7

# Claude model for knowledge graph extraction [Default: claude-haiku-4-5-20251001]
# Used by Graph strategy to extract entities and relationships from documents.
# Recommendation: Haiku is cheap and efficient for extraction tasks.
GRAPH_EXTRACTION_MODEL=claude-haiku-4-5-20251001

# Claude model for agentic retrieval [Default: claude-sonnet-4-6]
# Used by Agentic strategy to decide search/fetch steps dynamically.
# Recommendation: Sonnet balances reasoning and cost.
AGENTIC_MODEL=claude-sonnet-4-6

# ============================================================================
# Vector Database (Qdrant)
# ============================================================================

# Qdrant vector database URL [Default: http://localhost:6333]
# Docker: http://qdrant:6333 (service name on internal network)
# Local: http://localhost:6333
QDRANT_URL=http://localhost:6333

# Collection name for storing embeddings [Default: evalrag]
QDRANT_COLLECTION=evalrag

# ============================================================================
# SQL Database (PostgreSQL)
# ============================================================================

# PostgreSQL connection string [Default: postgresql+psycopg://evalrag:pw@localhost:5432/evalrag]
# Format: postgresql+psycopg://user:password@host:port/database
# Docker: postgresql+psycopg://evalrag:pw@postgres:5432/evalrag (service name)
# Local: postgresql+psycopg://evalrag:pw@localhost:5434/evalrag (may differ)
POSTGRES_URL=postgresql+psycopg://evalrag:pw@localhost:5432/evalrag

# ============================================================================
# Cache (Redis)
# ============================================================================

# Redis connection URL [Default: redis://localhost:6379/0]
# Format: redis://[host]:[port]/[db_number]
# Docker: redis://redis:6379/0 (service name)
# Local: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# ============================================================================
# Tracing Backend (Langfuse)
# ============================================================================
# Optional. If not set, traces are stored in-memory only.

# Langfuse host URL [Default: http://localhost:3000]
# Docker: http://langfuse:3000 (service name)
# Self-hosted: https://your-langfuse.example.com
# Cloud: https://cloud.langfuse.com
LANGFUSE_HOST=http://localhost:3000

# Langfuse public key [OPTIONAL]
# Leave blank to disable tracing.
LANGFUSE_PUBLIC_KEY=

# Langfuse secret key [OPTIONAL]
# Both public and secret keys must be set for tracing to work.
LANGFUSE_SECRET_KEY=

# ============================================================================
# Weights & Biases (W&B) - Eval Dashboards
# ============================================================================
# Optional. Eval runs are automatically synced if configured.

# W&B API key [OPTIONAL]
# Get at: https://wandb.ai/settings/keys
# Leave blank to disable. Eval still runs locally.
WANDB_API_KEY=

# W&B project name [Default: evalrag]
WANDB_PROJECT=evalrag

# W&B mode: online | offline | disabled [Default: online]
# - online: Sync to wandb.ai in real-time (requires internet)
# - offline: Log locally, sync later with `wandb sync`
# - disabled: Don't use W&B at all
WANDB_MODE=online

# ============================================================================
# Embedding Model
# ============================================================================

# HuggingFace embedding model [Default: BAAI/bge-small-en-v1.5]
# Used for all document and query embeddings.
# Options:
#   - BAAI/bge-small-en-v1.5    (fast, 384-dim, recommended)
#   - BAAI/bge-large-en-v1.5    (higher quality, slower)
#   - sentence-transformers/...  (many other options on HuggingFace Hub)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ============================================================================
# RAG Hyperparameters
# ============================================================================

# Document chunk size in tokens [Default: 600, Range: 100-2000]
# Larger chunks = more context per retrieval, fewer chunks to search
# Smaller chunks = more granular retrieval, higher cost
CHUNK_SIZE_TOKENS=600

# Overlap between consecutive chunks in tokens [Default: 80, Range: 0-500]
# Overlap helps maintain context between chunk boundaries.
CHUNK_OVERLAP_TOKENS=80

# Number of chunks to retrieve [Default: 50, Range: 1-100]
# More chunks = broader context, higher cost
# Fewer chunks = faster, tighter context
RETRIEVAL_TOP_K=50

# Number of chunks to keep after reranking [Default: 8, Range: 1-50]
# Reranker re-scores top-K to filter noise.
# Kept chunks are passed to the LLM for generation.
RERANK_TOP_K=8

# ============================================================================
# Agentic Strategy
# ============================================================================

# Maximum iterations for agentic loop [Default: 15, Range: 1-50]
# Each iteration is one tool call (search/fetch/finish).
# More iterations = more flexible reasoning, higher latency/cost.
AGENTIC_MAX_ITERS=15

# ============================================================================
# Graph RAG
# ============================================================================

# Directory to store knowledge graph data [Default: data/graph]
GRAPH_DATA_DIR=data/graph

# ============================================================================
# Frontend
# ============================================================================

# CORS allowed origins [Default: http://localhost:5173]
# Comma-separated list of URLs allowed to call the backend.
# Docker: http://localhost:5173 (Vite dev server)
# Production: https://yourapp.example.com
CORS_ORIGINS=http://localhost:5173
