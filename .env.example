# ============================================================================
# EvalRAG Configuration
# ============================================================================
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env          # macOS / Linux
#   copy .env.example .env        # Windows PowerShell
#
# The only setting you need for a working system is ANTHROPIC_API_KEY.
# Everything else has a working default.
#
# Get API keys:
#   - Anthropic: https://console.anthropic.com/settings/keys
#   - OpenAI:    https://platform.openai.com/account/api-keys
#   - W&B:       https://wandb.ai/settings
#
# ============================================================================

# ============================================================================
# LLM Provider API Keys
# ============================================================================

# Anthropic API key [REQUIRED]
# Used for answer generation, LLM-as-judge evaluation, graph extraction and the
# agentic strategy. Without it the backend starts but every answer is a refusal.
ANTHROPIC_API_KEY=

# OpenAI API key [OPTIONAL]
# Only needed for GENERATOR_PROVIDER=openai. Install the extra too:
#   pip install -e "backend[openai]"
OPENAI_API_KEY=

# ============================================================================
# Generator Configuration
# ============================================================================

# Generator provider: anthropic | openai | local
# - anthropic: Claude models (ANTHROPIC_API_KEY required)
# - openai:    GPT models (OPENAI_API_KEY required)
# - local:     Ollama on your machine (no API key)
GENERATOR_PROVIDER=anthropic

# Claude model for answer generation [Default: claude-sonnet-5]
# Current models, most to least capable:
#   claude-fable-5-1           most capable, highest cost
#   claude-opus-5-5            highest Opus-tier quality
#   claude-sonnet-5            balanced  [RECOMMENDED]
#   claude-haiku-4-5-20251001  fastest and cheapest
GENERATOR_MODEL=claude-sonnet-5

# Maximum tokens in a generated answer [Default: 1024, Range: 64-8192]
MAX_ANSWER_TOKENS=1024

# OpenAI model, used only when GENERATOR_PROVIDER=openai [Default: gpt-4o-mini]
OPENAI_GENERATOR_MODEL=gpt-4o-mini

# ============================================================================
# Ollama (Local LLM) - only used when GENERATOR_PROVIDER=local
# ============================================================================

# Ollama host. Docker Compose overrides this to reach your host machine.
OLLAMA_HOST=http://localhost:11434

# Ollama model. Pull it first: ollama pull llama3.1:8b
OLLAMA_MODEL=llama3.1:8b

# ============================================================================
# Evaluation Models
# ============================================================================

# Claude model for LLM-as-judge scoring [Default: claude-opus-5-5]
# The judge decides whether your answers are good, so quality matters here.
# Drop to claude-sonnet-5 if evaluation cost becomes a concern.
JUDGE_MODEL=claude-opus-5-5

# Claude model for knowledge graph extraction [Default: claude-haiku-4-5-20251001]
# One call per chunk, so this is the most volume-sensitive model in the system.
GRAPH_EXTRACTION_MODEL=claude-haiku-4-5-20251001

# Claude model for the agentic strategy [Default: claude-sonnet-5]
# Drives a tool-use loop, so it needs solid reasoning.
AGENTIC_MODEL=claude-sonnet-5

# Golden examples evaluated in parallel [Default: 4, Range: 1-32]
# Raise for faster eval runs; lower if you hit provider rate limits.
EVAL_CONCURRENCY=4

# ============================================================================
# Authentication & Rate Limiting
# ============================================================================

# Require an API key on /ask, /compare, /ingest, /eval and /graph
# [Default: false]
# Off by default so a fresh clone runs with no setup. Turn it on before
# exposing this backend beyond localhost.
REQUIRE_API_KEY=false

# Admin secret for /admin endpoints (creating and revoking API keys).
# Those endpoints return 503 while this is empty. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_KEY=

# Once REQUIRE_API_KEY=true and ADMIN_KEY is set, mint a key with:
#   python scripts/setup_auth.py --create-key "my-laptop"
# Then paste it into the field the UI shows, or send it yourself:
#   curl -H "Authorization: Bearer sk_..." http://localhost:8011/ingest/stats

# ============================================================================
# Privacy (GDPR) - see docs/gdpr/README.md
# =====================================================================
# ============================================================================

# What ingestion does with detected personal data (emails, French phone
# numbers, NIR, IBAN, SIREN/SIRET, card numbers, IPv4) [Default: mask]
#   off     index documents as they are
#   mask    replace each value with a placeholder such as [EMAIL] or [NIR]
#   reject  refuse the document with a 422 listing the types found
# Person names are NOT detected. Changing this applies to new ingests only.
PII_MODE_INGEST=mask

# Mask personal data in log lines [Default: true]
PII_REDACT_LOGS=true

# Mask personal data in stored and exported traces [Default: true]
PII_REDACT_TRACES=true

# Retention periods in days, purged daily and on POST /privacy/retention/run.
# 0 keeps records forever.
RETENTION_TRACES_DAYS=7
RETENTION_EVAL_RUNS_DAYS=365
RETENTION_AUDIT_DAYS=365
=======
# Access Control (tenants, document groups, audit)
# ============================================================================

# Tenant for API keys without one, OIDC users when OIDC_TENANT_CLAIM is empty,
# local mode, and chunks indexed before tenants existed.
DEFAULT_TENANT=default
# Label uploads that name no groups as 'public' instead of with the uploader's
# own groups. [Default: false]
ACL_DEFAULT_PUBLIC=false
# Treat chunks indexed before ACLs existed (no acl_groups) as public.
# Set false to hide them until re-ingested with groups. [Default: true]
ACL_LEGACY_PUBLIC=true
# Keep question text in the audit log. Off: only a SHA-256 hash. [Default: false]
AUDIT_STORE_QUESTIONS=false

# ============================================================================
# Single Sign-On (OIDC): Microsoft Entra ID, ProConnect, Keycloak, ...
# ============================================================================
# With REQUIRE_API_KEY=true and OIDC_ISSUER set, 'Authorization: Bearer <JWT>'
# from this issuer is accepted alongside API keys. Signatures are checked
# against the issuer's JWKS (found via /.well-known/openid-configuration).

# Entra:    https://login.microsoftonline.com/<tenant-id>/v2.0
# Keycloak: https://<host>/realms/<realm>
OIDC_ISSUER=
# Expected 'aud': your API's client id / app id URI. Required with OIDC_ISSUER.
OIDC_AUDIENCE=
# Claim holding groups. Dotted paths reach nested claims.
# Entra: groups (object ids) or roles; Keycloak: realm_access.roles
OIDC_GROUPS_CLAIM=groups
# Members of this group are admins (may label uploads with any group).
OIDC_ADMIN_GROUP=
# Claim naming the user's tenant, e.g. 'tid' on Entra. Empty: DEFAULT_TENANT.
OIDC_TENANT_CLAIM=
# Accepted signing algorithms (asymmetric only).
OIDC_ALGORITHMS=RS256,PS256,ES256
# Signing-key cache lifetime, seconds.
OIDC_JWKS_TTL_SECONDS=3600

# ============================================================================
# Vector Database (Qdrant)
# ============================================================================

# Qdrant URL. Docker Compose overrides this to http://qdrant:6333.
QDRANT_URL=http://localhost:6333
# Optional. Set to protect Qdrant; compose passes it to both Qdrant and the backend.
QDRANT_API_KEY=

# Collection name for stored embeddings [Default: evalrag]
QDRANT_COLLECTION=evalrag

# ============================================================================
# SQL Database (PostgreSQL) - stores API keys and usage accounting
# ============================================================================

# Only used when REQUIRE_API_KEY=true or ADMIN_KEY is set.
# Compose publishes Postgres on host port 5434.
POSTGRES_URL=postgresql+psycopg://evalrag:pw@localhost:5434/evalrag

# Password for the Compose Postgres service [Default: pw]
# Change this for anything reachable beyond your machine.
POSTGRES_PASSWORD=pw

# ============================================================================
# Embeddings & Reranking
# ============================================================================

# HuggingFace embedding model [Default: intfloat/multilingual-e5-small]
# The default is multilingual, so a French (German, Spanish, Italian...)
# question retrieves English passages and vice versa.
#   intfloat/multilingual-e5-small   384 dims, fast on CPU  [RECOMMENDED]
#   BAAI/bge-m3                      1024 dims, better multilingual ranking, ~4x slower
#   BAAI/bge-small-en-v1.5           384 dims, English only (the old default)
#
# RE-INGEST WHEN YOU SWITCH. The collection records the model that built it and
# the backend refuses to search it with a different one (HTTP 503,
# code "embedding_model_mismatch"), even when the dimensions match. Nothing is
# deleted for you: either set QDRANT_COLLECTION to a new name and run
# scripts/ingest.py, or delete the collection (docker compose ... down -v) and
# ingest again. Collections created before this check was added are refused
# too until you re-ingest (the error message shows how to stamp one instead).
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Input markers for the embedding model. Leave unset: they are chosen from the
# model family (E5 needs "query: " / "passage: ", bge-m3 and bge-*-en none).
# Set only for a model the table does not know; an empty value disables one.
# EMBEDDING_QUERY_PREFIX=
# EMBEDDING_PASSAGE_PREFIX=

# Cross-encoder used to rerank retrieved chunks.
# [Default: cross-encoder/mmarco-mMiniLMv2-L12-H384-v1, multilingual]
# For an English-only corpus, cross-encoder/ms-marco-MiniLM-L-6-v2 is about
# twice as fast. Changing the reranker does not require a re-ingest.
# Falls back to BM25 (accent-insensitive, English + French stopwords)
# automatically if the model cannot be loaded.
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1

# ============================================================================
# RAG Hyperparameters
# ============================================================================

# Words per chunk [Default: 300, Range: 100-2000]
# Larger chunks carry more context per hit; smaller chunks retrieve more
# precisely. Applies to newly ingested documents only. Counted in words, not
# model tokens: French and English run about 1.3-1.5 tokens per word, so 300
# words stay inside the 512-token window of the default embedder and reranker.
CHUNK_SIZE_TOKENS=300

# Words shared between neighbouring chunks [Default: 50, Range: 0-500]
# Must be smaller than CHUNK_SIZE_TOKENS. With the structured strategy the
# overlap is whole trailing sentences, up to this many words.
CHUNK_OVERLAP_TOKENS=50

# Input window of the embedder and reranker, in model tokens [Default: 512]
# The chunk size actually used is min(CHUNK_SIZE_TOKENS, this / 1.5): the
# default models (multilingual-e5-small, mMiniLM cross-encoder) silently
# truncate longer input, so the end of an oversized chunk would never be
# searched. Applies to both chunking strategies. Raise it for a long-context
# embedder (e.g. 8192 for OpenAI embeddings); 0 disables the cap.
CHUNK_MAX_MODEL_TOKENS=512

# How documents are cut into chunks [Default: structured]
#   structured - cut at headings (incl. French legal divisions), then pack whole
#                paragraphs; a paragraph larger than a chunk is split between
#                sentences, and overlap is made of whole trailing sentences.
#                Tables are split only between rows, with the header repeated.
#   fixed      - legacy overlapping word windows, kept for comparison.
# Applies to newly ingested documents only; re-ingest to compare.
CHUNK_STRATEGY=structured

# Retrieval pipeline:
#   query -> preprocess -> dense (DENSE_TOP_K) + BM25 (BM25_TOP_K)
#         -> Reciprocal Rank Fusion (RRF_K) -> rerank (RERANK_TOP_K)
#         -> context sent to the model (FINAL_CONTEXT_K)

# Which retrievers run [Default: hybrid, Options: dense, sparse, hybrid]
#   dense:  vector similarity only (the pre-hybrid behaviour)
#   sparse: BM25 keyword matching only, over an in-memory index of the corpus
#   hybrid: both, run concurrently and fused with Reciprocal Rank Fusion
RETRIEVAL_MODE=hybrid

# Candidates from dense (vector) retrieval [Default: 50, Range: 1-200]
DENSE_TOP_K=50

# Deprecated alias of DENSE_TOP_K, still honoured when DENSE_TOP_K is unset.
# RETRIEVAL_TOP_K=50

# Candidates from sparse (BM25) retrieval [Default: 50, Range: 1-200]
BM25_TOP_K=50

# Reciprocal Rank Fusion constant: score = sum of 1 / (RRF_K + rank)
# [Default: 60, Range: 1-1000]. Larger values flatten the head of each list.
RRF_K=60

# Chunks kept after reranking [Default: 8, Range: 1-50]
RERANK_TOP_K=8

# Chunks sent to the model [Default: RERANK_TOP_K, Range: 1-RERANK_TOP_K]
# This is the main lever on answer cost. A request's top_k overrides it.
# FINAL_CONTEXT_K=8

# ============================================================================
# Agentic Strategy
# ============================================================================

# Maximum tool calls in the agentic loop [Default: 15, Range: 1-50]
# Each iteration is one model call, so this bounds worst-case cost per question.
AGENTIC_MAX_ITERS=15

# ============================================================================
# Graph RAG
# ============================================================================

# Where extracted triples are stored. Use an absolute path under Docker;
# Compose sets /data/graph so the graph survives a rebuild.
GRAPH_DATA_DIR=data/graph

# ============================================================================
# Ingestion Limits
# ============================================================================

# Largest accepted upload, in megabytes [Default: 25, Range: 1-500]
MAX_UPLOAD_MB=25

# Largest total uncompressed size of a zip-based document (docx, pptx, odt,
# ods), in megabytes [Default: 200]. Checked before parsing, against zip bombs.
MAX_UNCOMPRESSED_MB=200

# ============================================================================
# OCR (scanned PDFs)
# ============================================================================

# OCR PDF pages with (almost) no text layer [Default: true]
# Needs the tesseract and poppler binaries (installed in the Docker image).
# Without them ingestion logs a warning and keeps whatever text was extracted.
OCR_ENABLED=true

# Tesseract language packs, joined by '+' [Default: fra+eng]
OCR_LANGUAGES=fra+eng

# Most pages OCR'd per document [Default: 50]. OCR costs seconds per page.
OCR_MAX_PAGES=50

# A PDF page with fewer extracted characters than this is OCR'd [Default: 50]
OCR_MIN_CHARS_PER_PAGE=50

# ============================================================================
# Provider Call Behaviour
# ============================================================================

# Per-request timeout for LLM calls, in seconds [Default: 60]
# Raise it if the agentic strategy times out on hard questions.
PROVIDER_TIMEOUT_SECONDS=60

# Retries for transient LLM failures [Default: 3, Range: 0-10]
# The Anthropic SDK's own retry is disabled, so this is the whole policy.
PROVIDER_MAX_RETRIES=3

# ============================================================================
# Telemetry policy - what may leave this machine (docs/monitoring.md)
# ============================================================================

# off | self_hosted | cloud [Default: off]
# - off:         no traces are exported anywhere. W&B may still run offline.
# - self_hosted: traces go only to hosts in TELEMETRY_ALLOWED_HOSTS (e.g. the
#                Langfuse in this Compose stack). Anything else is refused.
# - cloud:       any host, but only together with TELEMETRY_CLOUD_OPT_IN=true.
TELEMETRY_MODE=off

# Exporter hosts permitted in self_hosted mode (exact hostnames, no suffixes).
# Add your own EU-hosted Langfuse here, e.g. langfuse.internal.example.eu
TELEMETRY_ALLOWED_HOSTS=localhost,langfuse,127.0.0.1

# Second, explicit switch for cloud mode. Leave false unless you have a DPA
# with the telemetry vendor and have decided the transfer is acceptable.
TELEMETRY_CLOUD_OPT_IN=false

# Export question, answer and context text (after PII redaction). false sends
# only timings, token counts, model and strategy names. [Default: true]
TELEMETRY_INCLUDE_CONTENT=true

# Traces buffered for export; beyond this they are dropped and counted.
TELEMETRY_QUEUE_SIZE=1000

# ============================================================================
# Tracing (Langfuse) - optional
# ============================================================================
# Self-host it in this stack (Langfuse v4 + ClickHouse + Valkey + MinIO):
#   docker compose --env-file .env -f infra/docker-compose.yml --profile tracing up -d
# then set TELEMETRY_MODE=self_hosted. UI on http://localhost:3100.
# Compose points the backend at http://langfuse:3000; this value is for
# running the backend outside Docker.

LANGFUSE_HOST=http://localhost:3100
# Pick any values (pk-lf-... / sk-lf-...). With the tracing profile, Langfuse
# creates a project with exactly these keys on first start.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# First Langfuse login, created on first start (optional; leave blank to sign
# up in the UI instead).
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_NAME=
LANGFUSE_INIT_USER_PASSWORD=

# Secrets for the Langfuse containers [REQUIRED for --profile tracing].
# No defaults on purpose: Langfuse refuses to start while these are empty.
#   openssl rand -base64 32   (NEXTAUTH_SECRET, SALT, passwords)
#   openssl rand -hex 32      (ENCRYPTION_KEY: exactly 64 hex characters)
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
CLICKHOUSE_PASSWORD=
LANGFUSE_REDIS_PASSWORD=
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=

# ============================================================================
# Eval Dashboards (Weights & Biases) - optional
# ============================================================================
# Off unless WANDB_ENABLED=true, and TELEMETRY_MODE must permit the mode:
#   offline   local files under ./wandb only; allowed in every TELEMETRY_MODE
#   online    needs WANDB_API_KEY, and either TELEMETRY_MODE=cloud (+ opt-in)
#             or TELEMETRY_MODE=self_hosted with WANDB_BASE_URL on an allowed host
# Whenever W&B is not allowed the SDK is forced to WANDB_MODE=disabled.
# Evaluation always persists results locally under data/eval_runs/.

WANDB_ENABLED=false
WANDB_API_KEY=
WANDB_PROJECT=evalrag
# online | offline | disabled
WANDB_MODE=offline
# Self-hosted W&B server; blank means the W&B cloud (api.wandb.ai).
WANDB_BASE_URL=

# ============================================================================
# Metrics (Prometheus) - optional
# ============================================================================
# GET /metrics is served only when this is true, and then only to localhost
# or to requests with the X-Admin-Key header (so ADMIN_KEY must be set for the
# Compose `monitoring` profile, whose Prometheus scrapes with it):
#   docker compose --env-file .env -f infra/docker-compose.yml --profile monitoring up -d
# Prometheus: http://localhost:9090  Grafana: http://localhost:3300 (admin)
METRICS_ENABLED=false
GRAFANA_ADMIN_PASSWORD=

# ============================================================================
# Logging
# ============================================================================

# DEBUG | INFO | WARNING | ERROR [Default: INFO]
LOG_LEVEL=INFO

# Directory for rotating log files. Console logging is always on; file logging
# is skipped silently if this is not writable.
LOG_DIR=logs

# ============================================================================
# Frontend
# ============================================================================

# Comma-separated origins allowed to call the backend.
# Docker/dev: http://localhost:5173 (Vite). Production: your real origin.
CORS_ORIGINS=http://localhost:5173
